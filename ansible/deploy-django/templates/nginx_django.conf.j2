server {
    listen 80;
    server_name {{ ssl_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ ssl_domain }};

    # GeoIP2 config
    # This sub-file needs to be moved to another place, and included in the main nginx.conf.
    # include /etc/nginx/sites-available/geoip2.conf;

    # Run as web_user/web_group
    # It seems setting the user per server doesn't work like this?
    #user {{ web_user }} {{ web_group }};

    ssl_certificate {{ ssl_cert_path }};
    ssl_certificate_key {{ ssl_key_path }};

    access_log /var/log/nginx/{{ django_project_name }}.access.log;
    error_log /var/log/nginx/{{ django_project_name }}.error.log;

    # Needed by certbot to renew the SSL certificate periodically.
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        allow all;
        try_files $uri =404;
    }

    location /static/ {
        alias {{ django_app_dir }}/static/;
    }
    location /media/ {
        alias {{ django_app_dir }}/media/;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Pass GeoIP2 variables to Django via custom headers
        proxy_set_header X-Continent-Code $geoip2_data_continent_code;
        proxy_set_header X-Continent-Name $geoip2_data_continent_name;
        proxy_set_header X-Country-Code $geoip2_data_country_code;
        proxy_set_header X-Country-Name $geoip2_data_country_name;
        proxy_set_header X-Region-Code $geoip2_data_region_code;
        proxy_set_header X-Region-Name $geoip2_data_region_name;
        proxy_set_header X-City-Name $geoip2_data_city_name;
        proxy_set_header X-Latitude $geoip2_data_latitude;
        proxy_set_header X-Longitude $geoip2_data_longitude;
    }
}
